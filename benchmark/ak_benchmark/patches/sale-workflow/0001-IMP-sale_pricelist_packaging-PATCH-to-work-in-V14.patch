diff --git a/sale_pricelist_packaging/models/sale_order.py b/sale_pricelist_packaging/models/sale_order.py
index 233a3207f..45c84e881 100644
--- a/sale_pricelist_packaging/models/sale_order.py
+++ b/sale_pricelist_packaging/models/sale_order.py
@@ -6,8 +6,14 @@ from odoo import api, models
 
 class SaleOrderLine(models.Model):
     _inherit = "sale.order.line"
+    
+    @api.onchange("product_packaging")
+    def _onchange_product_packaging(self):
+        self.with_context(packaging=self.product_packaging).product_uom_change()
+        return super()._onchange_product_packaging()
 
-    @api.depends("product_id", "product_uom", "product_uom_qty", "product_packaging_id")
-    def _compute_pricelist_item_id(self):
-        self = self.with_context(packaging=self.product_packaging_id)
-        return super()._compute_pricelist_item_id()
+    def product_uom_change(self):
+        res = super().product_uom_change()
+        if self.product_packaging and "packaging" not in self.env.context:
+            self = self.with_context(packaging=self.product_packaging)
+        return res
